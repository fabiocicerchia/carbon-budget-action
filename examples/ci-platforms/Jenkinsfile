// Jenkins — carbon budget gate on every change.
// Copy into a Jenkinsfile at the repo root (Multibranch Pipeline picks it up).
pipeline {
  // Any agent with Python 3.10+ works; the estimator has no dependencies.
  agent {
    docker { image 'python:3.13-slim' }
  }

  environment {
    BUDGET_GCO2E   = '5000'
    REPLICAS       = '4'
    CPU_REQUEST    = '500m'
    MEMORY_REQUEST = '1Gi'
    GRID_INTENSITY = '56' // eu-north-1; default 480 (world average)
    // MODE        = 'report'  // never fail the build — the adoption on-ramp
  }

  stages {
    stage('Carbon budget') {
      steps {
        sh '''
          python3 -c "import urllib.request;urllib.request.urlretrieve('https://raw.githubusercontent.com/fabiocicerchia/carbon-budget-action/v0.2.0/carbon_budget.py','carbon_budget.py')"
          # Exit 1 over budget in gate mode — that is the whole gate.
          python3 carbon_budget.py | tee carbon-budget.md
        '''
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'carbon-budget.md', allowEmptyArchive: true
    }
  }
}
